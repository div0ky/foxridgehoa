# Nuxt (public; Convex deployment URLs from the Convex dashboard)
NUXT_PUBLIC_CONVEX_URL=
NUXT_PUBLIC_CONVEX_SITE_URL=

# Site origin for Better Auth (must match the browser origin exactly, no trailing path)
# Set on Convex (not only in this file): `npx convex env set SITE_URL http://localhost:3000`
# If sign-in fails with "Invalid origin", SITE_URL on your Convex deployment is wrong for that URL.
SITE_URL=

# Optional comma-separated extra origins for Better Auth (Convex: `npx convex env set TRUSTED_ORIGINS ...`)
# Use when you need both local and preview URLs without changing SITE_URL.
# TRUSTED_ORIGINS=

# Convex HTTP site URL (same as deployment “.convex.site” URL)
# `npx convex env set CONVEX_SITE_URL ...` must match
CONVEX_SITE_URL=

# Better Auth secret (Convex: `npx convex env set BETTER_AUTH_SECRET ...` — generate a long random string)
BETTER_AUTH_SECRET=

# One-time Convex secret for CLI bootstrap (Convex only: `npx convex env set OPERATOR_BOOTSTRAP_SECRET ...`)
OPERATOR_BOOTSTRAP_SECRET=

# Resend (Convex only — used by board contact email and admin invitations; set vars on your Convex deployment)
# Names must match exactly (underscores, all caps):
# npx convex env set RESEND_API_KEY re_...
# npx convex env set RESEND_FROM "Fox Ridge HOA <noreply@your-verified-domain>"
# npx convex env set RESEND_TO "board-inbox@your-verified-domain"
# Board members configured in Admin → Board contact receive copies via BCC; RESEND_TO is the required "to" address.
